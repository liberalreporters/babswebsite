{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babswebsite-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
